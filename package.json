  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm foundations:check && pnpm tokens:check && pnpm test:foundations && pnpm typecheck && pnpm test && pnpm test:release && pnpm build && pnpm test:package",
    "test:package": "node scripts/check-package.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "semantic-release",
    "test:release": "node --test scripts/release-policy.test.mjs",
    "tokens:generate": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check",
    "test:foundations": "node --test scripts/tokens.test.mjs scripts/css-modules.test.mjs scripts/packed-browser.test.mjs",
    "foundations:check": "node scripts/check-foundations.mjs",
    "test:foundation-consumer": "pnpm build && node scripts/test-foundation-consumer.mjs",
    "test:hydration-consumer": "pnpm build && node scripts/test-foundation-consumer.mjs --react18 --browser && node scripts/test-foundation-consumer.mjs --browser",
    "test:next-consumer": "pnpm build && node scripts/test-next-consumer.mjs",
    "test:browser": "tsc --noEmit -p tests/browser/tsconfig.json && playwright test"
  },
