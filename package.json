{
  "name": "sg-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @structured-growth/sg-ui build",
    "typecheck": "pnpm --filter @structured-growth/sg-ui typecheck",
    "test": "pnpm --filter @structured-growth/sg-ui test",
    "test:watch": "pnpm --filter @structured-growth/sg-ui test:watch",
    "check": "pnpm --filter @structured-growth/sg-ui check",
    "test:package": "pnpm --filter @structured-growth/sg-ui test:package",
    "release": "pnpm --filter @structured-growth/sg-ui release",
    "test:release": "pnpm --filter @structured-growth/sg-ui test:release",
    "tokens:generate": "pnpm --filter @structured-growth/sg-ui tokens:generate",
    "tokens:check": "pnpm --filter @structured-growth/sg-ui tokens:check",
    "test:foundations": "pnpm --filter @structured-growth/sg-ui test:foundations",
    "foundations:check": "pnpm --filter @structured-growth/sg-ui foundations:check",
    "test:foundation-consumer": "pnpm --filter @structured-growth/sg-ui test:foundation-consumer",
    "test:hydration-consumer": "pnpm --filter @structured-growth/sg-ui test:hydration-consumer",
    "test:next-consumer": "pnpm --filter @structured-growth/sg-ui test:next-consumer",
    "test:browser": "pnpm --filter @structured-growth/sg-ui test:browser",
    "dev:docs": "pnpm build && pnpm --filter @structured-growth/docs dev",
    "build:docs": "pnpm build && pnpm --filter @structured-growth/docs build",
    "check:docs": "pnpm build && pnpm --filter @structured-growth/docs typecheck",
    "test:docs": "pnpm build:docs && pnpm --filter @structured-growth/docs test:e2e",
    "pack:ui": "pnpm --filter @structured-growth/sg-ui pack",
    "build:browser-docs": "pnpm --filter @structured-growth/sg-ui build:browser-docs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3"
  }
}
