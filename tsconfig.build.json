{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "**/*.test.*",
    "**/*.stories.*",
    "src/fixtures",
    "node_modules",
    "dist"
  ]
}
