--- /dev/null
+++ b/packages/ui/src/experimental/DateTimeRangePicker/DateTimeRangePicker.boundaries.test.tsx
@@ -0,0 +1,51 @@
+// @vitest-environment jsdom
+import {afterEach,it,expect,vi} from 'vitest';
+import {render,screen,cleanup} from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import {DateTimeRangePicker} from './DateTimeRangePicker';
+afterEach(cleanup);
+
+it('commits an overnight edit atomically and preserves endpoint seconds in submitted values',async()=>{
+ const user=userEvent.setup(),change=vi.fn();
+ const initial={start:'2026-10-07T23:30:00',end:'2026-10-08T00:15:00'};
+ const {container}=render(<form><DateTimeRangePicker label="Overnight" name="trip" defaultValue={initial} hourCycle={24} onValueChange={change}/></form>);
+ const accepted=()=>Object.fromEntries(new FormData(container.querySelector('form')!));
+ await user.click(screen.getByRole('button',{name:'Overnight',exact:true}));
+ const time=screen.getByRole('textbox',{name:'End time',exact:true});
+ await user.clear(time);await user.type(time,'00:15:37');await user.tab();
+ expect(change).not.toHaveBeenCalled();expect(accepted()).toEqual({'trip.start':initial.start,'trip.end':initial.end});
+ await user.click(screen.getByRole('button',{name:'Apply',exact:true}));
+ const expected={...initial,end:'2026-10-08T00:15:37'};
+ expect(change).toHaveBeenCalledExactlyOnceWith(expected);
+ expect(accepted()).toEqual({'trip.start':expected.start,'trip.end':expected.end});
+});
+
+it('rejects a reversed same-date end and Cancel preserves both accepted fields',async()=>{
+ const user=userEvent.setup(),change=vi.fn();
+ const initial={start:'2026-10-07T23:30:00',end:'2026-10-07T23:45:19'};
+ const {container}=render(<form><DateTimeRangePicker label="Same day" name="trip" defaultValue={initial} hourCycle={24} onValueChange={change}/></form>);
+ await user.click(screen.getByRole('button',{name:'Same day',exact:true}));
+ const time=screen.getByRole('textbox',{name:'End time',exact:true});
+ await user.clear(time);await user.type(time,'00:15:00');await user.tab();
+ expect((screen.getByRole('button',{name:'Apply',exact:true}) as HTMLButtonElement).disabled).toBe(true);
+ expect(change).not.toHaveBeenCalled();
+ await user.click(screen.getByRole('button',{name:'Cancel',exact:true}));
+ expect(Object.fromEntries(new FormData(container.querySelector('form')!))).toEqual({'trip.start':initial.start,'trip.end':initial.end});
+});
+
+it('accepts exact inclusive midnight bounds and rejects one second beyond max',async()=>{
+ const user=userEvent.setup(),change=vi.fn();
+ const initial={start:'2026-10-07T23:30:00',end:'2026-10-08T00:00:00'};
+ const {container}=render(<form><DateTimeRangePicker label="Midnight" name="trip" defaultValue={initial} min={initial.start} max={initial.end} hourCycle={24} onValueChange={change}/></form>);
+ const trigger=()=>screen.getByRole('button',{name:'Midnight',exact:true});
+ await user.click(trigger());
+ expect((screen.getByRole('button',{name:'Apply',exact:true}) as HTMLButtonElement).disabled).toBe(false);
+ const time=screen.getByRole('textbox',{name:'End time',exact:true});
+ await user.clear(time);await user.type(time,'00:00:01');await user.tab();
+ expect((screen.getByRole('button',{name:'Apply',exact:true}) as HTMLButtonElement).disabled).toBe(true);
+ expect(change).not.toHaveBeenCalled();
+ await user.clear(time);await user.type(time,'00:00:00');await user.tab();
+ await user.click(screen.getByRole('button',{name:'Apply',exact:true}));
+ expect(change).toHaveBeenCalledExactlyOnceWith(initial);
+ expect(Object.fromEntries(new FormData(container.querySelector('form')!))).toEqual({'trip.start':initial.start,'trip.end':initial.end});
+});
