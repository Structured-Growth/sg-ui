+      await page.evaluate(()=>{window.sguiPerf.unmount();window.sguiPerf.unmount();});
+      await page.waitForTimeout(250); // Intentional observation window for an incorrectly retained 100ms interval.
+      const disposed=await page.evaluate(()=>({children:document.getElementById('root').childElementCount,scopes:document.querySelectorAll('[data-sgui-scope]').length,options:document.querySelectorAll('[role=option]').length,updating:window.sguiPerf.updating,samples:window.sguiPerf.samples.length}));
+      assert.equal(disposed.children,0);assert.equal(disposed.scopes,0);assert.equal(disposed.options,0);assert.equal(disposed.updating,false);
+      await page.waitForTimeout(250);
+      assert.equal(await page.evaluate(()=>window.sguiPerf.samples.length),disposed.samples,'Disposed fixture kept producing samples');
+      record.cycles.push({cycle,warmup:cycle<5,disposed,afterGC:await counters()});
+      if(cycle===4)await snapshot(workload+'-warm');
+      if(cycle===29)await snapshot(workload+'-final');
+      assert.deepEqual(diagnostics,[],'Browser diagnostics');await save();
+    }
+  }
+  assert.deepEqual(await inventory(join(here,'dist')),receipt.assets,'Profiling assets changed');
+  assert.deepEqual(await inventory(join(here,'../../dist')),receipt.libraryOutput,'Library output changed');
+  receipt.status='pass';
+}catch(error){receipt.status='fail';receipt.failure=String(error.stack??error);process.exitCode=1;}
+finally{await browser?.close();receipt.finishedAt=new Date().toISOString();await save();}
