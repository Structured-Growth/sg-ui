--- /dev/null
+++ b/apps/docs/native-fixtures/scenarios/experimental/BrowserZoomAcceptance/BrowserZoomAcceptance.fixture.tsx
@@ -0,0 +1,86 @@
+import { useState } from 'react';
+import { AppModal, AppPageTabs, AppShell, ClassCardFrame, DataToolbar, SideNavigation, type SideNavigationModel } from '@structured-growth/sg-ui/components';
+import { Box, Button, Card, CardContent, Divider, SplitAction, Stack, Status, Surface, TextField, Typography } from '@structured-growth/sg-ui/experimental';
+import type { Meta, StoryObj } from '../../../types';
+
+const meta = { title: 'Migration proofs/Browser zoom acceptance' } satisfies Meta;
+export default meta;
+type Story = StoryObj;
+
+function LayoutCase() {
+  return <Box container padding={3} data-testid="zoom-layout">
+    <Stack direction="row" responsive wrap gap={3}>
+      <Surface tone="subtle" padding={2} style={{ flex: '1 1 16rem', minInlineSize: 0 }}>
+        <Card><CardContent><Typography as="h2" variant="h3">International learning plan</Typography>
+          <Typography>Review long course descriptions and supporting materials without losing content when browser zoom changes.</Typography>
+          <Divider /><Button>Review learning plan</Button>
+        </CardContent></Card>
+      </Surface>
+      <ClassCardFrame style={{ flex: '1 1 16rem', minInlineSize: 0 }}
+        header={<Typography as="h3" variant="h5">International collaborative course planning and materials review</Typography>}
+        body={<Typography>خطة الدورة الدولية لتطوير مهارات القيادة والتعاون ومراجعة المواد التعليمية</Typography>}
+        footer={<Button>Open course plan</Button>} />
+    </Stack>
+  </Box>;
+}
+export const Layout: Story = { render: () => <LayoutCase /> };
+
+function ToolbarCase({ name, width }: { name: string; width: string }) {
+  const [query, setQuery] = useState('');
+  const [result, setResult] = useState('');
+  return <section aria-label={`${name} zoom toolbar host`} style={{ inlineSize: '100%', maxInlineSize: width }}>
+    <DataToolbar aria-label={`${name} zoom toolbar`} searchValue={query} onSearchValueChange={setQuery}
+      showRefreshButton={false} showColumnsButton={false} showFilterButton={false} showSortButton={false}
+      leftContent={<SplitAction label={`Create ${name.toLowerCase()} course`} menuLabel={`${name} zoom course actions`}
+        items={[{ id: 'import', label: 'Import course materials' }]}
+        onPress={() => setResult(`${name} course created`)} onAction={() => setResult(`${name} course materials imported`)} />} />
+    <Status announcement="polite">{result}</Status>
+  </section>;
+}
+export const Toolbar: Story = { render: () => <Stack gap={3} data-testid="zoom-toolbars">
+  <ToolbarCase name="First" width="22rem" /><ToolbarCase name="Second" width="48rem" />
+</Stack> };
+
+const navigation: SideNavigationModel = {
+  user: { initials: 'SG', name: 'Course planning team', organization: 'Learning workspace' },
+  rootMenu: { id: 'zoom-courses', sections: [{ id: 'courses', title: 'Course planning', items: Array.from({ length: 18 }, (_, index) => ({
+    id: `zoom-course-${index}`, label: `International course plan ${index + 1}`, href: `#course-${index + 1}`,
+  })) }] },
+};
+function NavigationCase() {
+  return <AppShell mainLabel="Browser zoom workspace" style={{ inlineSize: '100%', maxInlineSize: '54rem', blockSize: '28rem' }}
+    navigation={<SideNavigation model={navigation} aria-label="Browser zoom course navigation" />}>
+    <Stack gap={3} style={{ padding: 'var(--sgui-space4)', minInlineSize: 0 }}>
+      <Typography as="h1" variant="h2">Collaborative learning workspace</Typography>
+      <TextField label="Zoom workspace title" defaultValue="International learning plan" />
+      {Array.from({ length: 10 }, (_, index) => <section key={index}>
+        <Typography as="h2" variant="h3">Course materials {index + 1}</Typography>
+        <Typography>Review materials and host-owned course settings while keeping keyboard focus visible in the main scroll pane.</Typography>
+        <Button>Review zoom section {index + 1}</Button>
+      </section>)}
+    </Stack>
+  </AppShell>;
+}
+export const Navigation: Story = { render: () => <NavigationCase /> };
+
+function ModalCase({ name, width }: { name: string; width: number }) {
+  const [open, setOpen] = useState(false);
+  const [tab, setTab] = useState('details');
+  return <>
+    <Button onPress={() => setOpen(true)}>Open {name} zoom modal</Button>
+    <AppModal open={open} title={`${name} browser zoom settings`} width={width} height={560} showCloseButton
+      subtitle="Host-owned settings remain keyboard reachable at actual browser zoom"
+      onClose={() => setOpen(false)} steps={{ current: 2, total: 3 }}
+      primaryAction={{ label: 'Save zoom settings', onPress: () => setOpen(false) }}
+      secondaryAction={{ label: 'Cancel zoom settings', onPress: () => setOpen(false) }}>
+      <AppPageTabs label={`${name} zoom settings sections`} value={tab} onChange={setTab} items={[
+        { id: 'details', label: 'Details', content: <>{Array.from({ length: 8 }, (_, index) =>
+          <TextField key={index} label={`Zoom setting ${index + 1}`} autoFocus={index === 0} />)}</> },
+        { id: 'access', label: 'Access', content: <TextField label="Zoom permission" /> },
+      ]} />
+    </AppModal>
+  </>;
+}
+export const Modal: Story = { render: () => <Stack direction="row" wrap gap={3}>
+  <ModalCase name="narrow" width={360} /><ModalCase name="wide" width={800} />
+</Stack> };
